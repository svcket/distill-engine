{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"develop\" ]; then prisma generate && next build; else echo 'Skipping build for non-main branch'; exit 0; fi",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "cd .. && python3 -m pytest tests/test_pipeline.py -v",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
