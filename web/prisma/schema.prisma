// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  sources       Source[]
  drafts        Draft[]
  usage         Usage?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Engine Preferences
  writingStyle     String  @default("balanced")
  preferredTone    String  @default("professional")
  defaultLength    String  @default("medium")
  
  // Processing Defaults
  autoStartPipeline Boolean @default(false)
  generateSummaries Boolean @default(true)
  
  updatedAt        DateTime @updatedAt
}

model Source {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  url              String
  type             String // youtube, podcast, etc
  status           String // pending, processing, completed, failed
  content          String?
  published        String?
  duration         String?
  score            Int      @default(0)
  completedStages  String?  // Comma-separated string for SQLite
  transcriptStatus String?  @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Draft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Usage {
  id               String @id @default(cuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcesProcessed Int    @default(0)
  draftsGenerated  Int    @default(0)
  currentPlan      String @default("free")
  updatedAt        DateTime @updatedAt
}
